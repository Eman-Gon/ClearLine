# Copy to .env; keep filled credentials out of version control.
# Start via: python -m uvicorn backend.main:app --env-file .env --port 3000
CLEARLINE_PAIRING_CODE=replace-with-a-private-demo-code
CLEARLINE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLEARLINE_DB=backend/data/clearline.sqlite3
CLEARLINE_UPLOAD_DIR=backend/data/uploads
WHISPER_MODEL_PATH=
FFMPEG_BINARY=ffmpeg

# Laptop-local, unauthenticated loopback llama.cpp server. No Liquid key required.
LIQUID_BASE_URL=http://127.0.0.1:8080/v1
LIQUID_MODEL=clearline-liquid
RAWTREE_BASE_URL=https://api.rawtree.com
RAWTREE_DATABASE=default
RAWTREE_API_KEY=
NIMBLE_API_KEY=
